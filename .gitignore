node_modules/
dist/
.env

# Local env overrides (NOTE: keep .env.production committed — it holds the non-secret
# API URL that Vercel and the app build need)
.env.local
.env.*.local

# Android signing keystore — NEVER commit. It signs your app; a leak lets anyone
# publish hijacked updates. Store it safely outside the repo + back it up.
*.jks
*.keystore
